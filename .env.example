# PostgreSQL (Neon, Supabase, Railwayなど標準PostgreSQL接続文字列)
DATABASE_URL=postgresql://user:password@host:5432/power_watch?sslmode=require

# 初期管理者（pnpm db:seed 実行時のみ使用）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-at-least-12-chars

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=power-watch

# セッション
SESSION_COOKIE_NAME=pw_session

# 本番URL（同一オリジン検証・将来のコールバック用）
APP_URL=http://localhost:3000

# AI Director（Phase 2）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol

# Video generation (Phase 3 / Runway Dev)
RUNWAY_API_KEY=
VIDEO_MODEL_CINEMATIC=gen4.5
VIDEO_MODEL_ANIMATION=gen4.5
VIDEO_GENERATION_CONCURRENCY=2
VIDEO_JOB_MAX_RETRIES=3
VIDEO_POLL_DELAY_SECONDS=7
VIDEO_DOWNLOAD_TIMEOUT_MS=60000
VIDEO_DOWNLOAD_MAX_BYTES=209715200
RUNWAY_CREDIT_COST_USD=0.01
